			# в default-src 'self' → пустой серый шелл «РЕКЛАМА». Домены —
			# официальный CSP-набор партнёрки (adfox / yandexadexchange / *.yandex.*).
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net https://yandex.ru https://an.yandex.ru https://*.yandex.ru https://*.adfox.ru; style-src 'self' 'unsafe-inline' https://yastatic.net https://*.adfox.ru; font-src 'self' https://yastatic.net data:; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yandex.ru https://an.yandex.ru https://avatars.mds.yandex.net https://yastatic.net https://*.yandex.net https://*.yandex.ru https://*.adfox.ru https://yandex.com; media-src 'self' blob: data: https://yastatic.net https://yandex.ru https://an.yandex.ru https://*.yandex.ru https://*.yandex.net https://*.adfox.ru https://yandex.com; connect-src 'self' blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https:
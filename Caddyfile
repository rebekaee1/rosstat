{$PUBLIC_HOST:forecasteconomy.com} {
	# О-16: границы на edge — тело запроса и таймауты проксирования.
	# Стандартная сборка Caddy без rate-limit-плагина; лимит запросов живёт
	# в backend-middleware (по /api/), SSR-прожиг сдерживают Redis HTML-кэш
	# и nginx-таймауты.
	request_body {
		max_size 1MB
	}

	# Embed SVG API: CORS for cross-origin <img> usage
	@embedapi path_regexp embedapi ^/api/v1/embed/
	header @embedapi Access-Control-Allow-Origin "*"

	# Embed widget routes: frameable from any domain (handle is mutually exclusive)
	@embed path_regexp embed ^/embed/(chart|card|table|ticker|compare)(/.*)?$
	handle @embed {
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "frame-ancestors *; default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'"
		}
		reverse_proxy localhost:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# All other routes: standard security headers
	handle {
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"

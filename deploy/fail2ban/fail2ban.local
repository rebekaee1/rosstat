# fail2ban: журнал /var/log/fail2ban.log только с событиями Ban/Unban и выше.
#
# До 2026-10-27 стоял INFO: каждый совпавший запрос (`Found IP`) и каждый
# пропуск доверенного IP (`Ignore IP`) попадали в журнал. Против распределённого
# скрейпа (десятки тысяч разных IP) это ~100 МБ в сутки: fail2ban.log.1 = 547 МБ
# за неделю, текущий = 269 МБ за 2,5 суток. Бан/разбан пишутся на уровне NOTICE.
[Definition]
loglevel = NOTICE

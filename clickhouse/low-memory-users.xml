<!-- Пер-query лимиты под контейнер 448 MiB (docker-compose.yml; срез 2026-09-27): срезы BI — маленькие GROUP BY,
     300 MiB на запрос; внешние агрегации могут использовать диск.
     Достаточность этого бюджета проверяется нагрузкой, а не размером лимита. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>314572800</max_memory_usage>
            <max_bytes_before_external_group_by>157286400</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>157286400</max_bytes_before_external_sort>
            <max_threads>2</max_threads>
        </default>
    </profiles>
</clickhouse>

# ============================================
# Forecast Economy — Environment Variables
# ============================================
# Скопируй в .env и поменяй ВСЕ пароли/секреты.
# Если .env когда-либо попадал в git — немедленно ротировать все секреты.
#
# Полный каталог настроек — backend/app/config.py (Settings, префикс RUSTATS_).
# Здесь перечислены переменные, которые реально читает docker-compose.yml;
# всё прочее из Settings можно переопределить, добавив RUSTATS_<UPPER_NAME>=…
# ============================================

# --- Инфраструктура (ОБЯЗАТЕЛЬНО сменить на проде) ---
POSTGRES_PASSWORD=rustats_dev
REDIS_PASSWORD=changeme
# Политика вытеснения кэш-Redis (redis, DB 0). Прод: allkeys-lru.
REDIS_CACHE_POLICY=noeviction
CLICKHOUSE_PASSWORD=analytics_dev
# Uvicorn workers (default: 2). Бюджет соединений БД: workers × (pool 5 +
# overflow 10) < 80 (max_connections=100 минус транзиенты alembic/seed/pg_dump).
# Пул настраивается RUSTATS_DB_POOL_SIZE / RUSTATS_DB_MAX_OVERFLOW (О-15).
UVICORN_WORKERS=2
# Статический IP api.telegram.org для extra_hosts (обход DNS-блокировок)
TELEGRAM_API_IP=149.154.167.220

# --- Режим приложения ---
# Прод: false (включает prod-assertions на старте; true открывает /api/docs)
RUSTATS_DEBUG=false

# --- Планировщик ETL (Moscow time; вечерний прогон 20:00 зашит в Settings) ---
RUSTATS_SCHEDULER_CRON_HOUR=6
RUSTATS_SCHEDULER_CRON_MINUTE=0

# --- Прогнозы ---
RUSTATS_FORECAST_STEPS=12

# --- Защита внутренних endpoint'ов ---
# Токен /metrics (пусто = endpoint без токена; прод — задать)
RUSTATS_METRICS_TOKEN=
# Токен внутреннего REST /api/v1/analytics/* (401 без него)
RUSTATS_ANALYTICS_API_TOKEN=

# --- Auth / личный кабинет (прод: secure=true, https-URL) ---
RUSTATS_AUTH_COOKIE_SECURE=false
RUSTATS_AUTH_PUBLIC_BASE_URL=http://localhost:3000
RUSTATS_AUTH_FAKE_PROVIDER_ENABLED=false
RUSTATS_OAUTH_YANDEX_CLIENT_ID=
RUSTATS_OAUTH_YANDEX_CLIENT_SECRET=
RUSTATS_OAUTH_YANDEX_SCOPE=
RUSTATS_OAUTH_YANDEX_REDIRECT_URI=
RUSTATS_OAUTH_VK_CLIENT_ID=
RUSTATS_OAUTH_VK_CLIENT_SECRET=
RUSTATS_OAUTH_VK_SERVICE_KEY=
RUSTATS_OAUTH_VK_SCOPE=
RUSTATS_OAUTH_VK_REDIRECT_URI=

# --- Состояние (сессии/lockout/квоты) ---
# Дефолт: DB 1 того же Redis. Переезд на выделенный redis-state (AOF):
# RUSTATS_STATE_REDIS_URL=redis://:<REDIS_PASSWORD>@redis-state:6379/0
RUSTATS_STATE_REDIS_URL=

# --- Гостевые лимиты выгрузок ---
RUSTATS_DOWNLOAD_ANON_LIMIT=0
RUSTATS_DOWNLOAD_ANON_HISTORY_YEARS=3

# --- Telegram (алерты, дайджест, «Пульс») ---
RUSTATS_TELEGRAM_BOT_TOKEN=
RUSTATS_TELEGRAM_CHAT_ID=
RUSTATS_TELEGRAM_DIGEST_ENABLED=false
RUSTATS_TELEGRAM_DIGEST_CHAT_IDS=
RUSTATS_TELEGRAM_REALTIME_ALERTS_ENABLED=true
RUSTATS_PULSE_ENABLED=false
RUSTATS_PULSE_CHAT_ID=
RUSTATS_TELEGRAM_POLLER_ENABLED=false

# --- LLM («Пульс»-отчёт) ---
RUSTATS_OPENROUTER_API_KEY=
RUSTATS_OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Опционально: HTTP-forward-proxy для запросов к OpenRouter (нужен, если
# сервер стоит в юрисдикции, которую блокирует апстрим-провайдер модели).
# Пусто = без прокси.
RUSTATS_OPENROUTER_PROXY_URL=
# ETL parsers: empty = reuse OPENROUTER_PROXY_URL (direct → proxy on 403/429/503)
# Set to "off" to skip HTTP hop (SOCKS-only), e.g. when OpenRouter DC also gets 503 on Minfin
RUSTATS_ETL_HTTP_PROXY_URL=
# SOCKS after HTTP fails (prod Tor on compose bridge gw): socks5h://172.18.0.1:9050
RUSTATS_ETL_SOCKS_PROXY_URL=

# --- Forecast Analytics OS (Яндекс Метрика/Вебмастер) ---
RUSTATS_FRONTEND_EVENTS_ENABLED=true
RUSTATS_ANALYTICS_ENABLED=false
RUSTATS_ANALYTICS_SCHEDULER_ENABLED=false
RUSTATS_ANALYTICS_ALLOWED_COUNTER_IDS=107136069
RUSTATS_ANALYTICS_ALLOWED_HOSTS=forecasteconomy.com
# false на локалке/стейдже. На проде true — иначе cron переобхода Вебмастера
# (webmaster_recrawl, ~150 URL/день) режется action_policy и квота сгорает впустую.
RUSTATS_ANALYTICS_LIVE_WRITES_ENABLED=false
RUSTATS_WEBMASTER_RECRAWL_ENABLED=true
RUSTATS_YANDEX_METRIKA_READ_TOKEN=
RUSTATS_YANDEX_METRIKA_WRITE_TOKEN=
RUSTATS_YANDEX_WEBMASTER_TOKEN=

# --- OLAP ClickHouse (BI «Срезы»; сайт живёт и без него) ---
RUSTATS_CLICKHOUSE_ENABLED=true

# --- Яндекс.Директ (расходы кампаний; после передачи токена) ---
RUSTATS_DIRECT_API_TOKEN=
# Яндекс.Партнёр (РСЯ) — только prod .env, не коммитить значения
RUSTATS_YANDEX_PARTNER_CLIENT_ID=
RUSTATS_YANDEX_PARTNER_CLIENT_SECRET=
RUSTATS_YANDEX_PARTNER_TOKEN=

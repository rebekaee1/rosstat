# Прокси API в режиме `npm run dev` (Vite).
# По умолчанию — VITE_PUBLIC_BASE_URL (или https://forecasteconomy.com), чтобы
# на экране были реальные данные без локального backend.
# Для работы только с локальным API (docker / uvicorn):
# VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Публичный origin (canonical / robots / llms / embed). Дефолт в коде =
# https://forecasteconomy.com; для Docker build см. docker-compose build.args.
# VITE_PUBLIC_BASE_URL=https://forecasteconomy.com
